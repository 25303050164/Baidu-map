# Server-side AK only. Copy to .env locally; never commit .env.
BAIDU_MAP_AK=
# baidu requires both a server AK and an explicitly configured QPS.
# Use synthetic for offline integration; no real routing requests are sent.
ANALYSIS_PROVIDER=baidu
ANALYSIS_QPS=
# Optional prepared OSM cache. Keep PBF, .poly and .osm-cache artifacts out of Git.
# Relative paths resolve from the backend directory.
OSM_CACHE_PATH=data/osm-cache
OSM_CACHE_VERSION=
OSM_WALK_SPEED_MPS=1.3
# JSON array of exact origins, without trailing slashes.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
