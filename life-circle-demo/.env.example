# API is the default. Use demo only for the original simulated facility demo.
VITE_ANALYSIS_MODE=api
VITE_API_BASE_URL=http://127.0.0.1:8000
# Shows the local-only developer mode switch when set to true. This is not an auth boundary.
VITE_ENABLE_DEVELOPER_MODE=false
# Browser map AK only; never put the server walking AK here.
VITE_BAIDU_MAP_AK=
